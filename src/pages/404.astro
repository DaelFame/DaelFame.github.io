---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Joaquin Cardenas" description="This page does not exist." hideLangSwitch>
  <section class="section">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>This page does not exist.</h1>
      <p class="lede" style="margin-block-start:1rem">
        The numbers move. The links should not. Let's go back.
      </p>
      <div class="row" style="margin-block-start:1.75rem">
        <a class="btn" href="/">Home</a>
        <a class="btn btn-ghost" href="/work/">Case studies</a>
      </div>
    </div>
  </section>
</BaseLayout>
