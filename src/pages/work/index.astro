---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import { cases } from '../../data/cases';
import { useTranslations } from '../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<BaseLayout title={t('work.meta.title')} description={t('work.meta.description')} lang={lang}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{t('nav.work')}</p>
      <h1 class="page-title">{t('work.heading')}</h1>
      <p class="page-intro">{t('work.intro')}</p>

      <div class="case-grid case-grid--page">
        {cases.map((item) => <CaseCard item={item} lang={lang} />)}
      </div>
    </div>
  </section>
</BaseLayout>
