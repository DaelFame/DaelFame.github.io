---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroWaterfall from '../components/HeroWaterfall.astro';
import Pillars from '../components/Pillars.astro';
import Github from '../components/Github.astro';
import Linkedin from '../components/Linkedin.astro';
---

<BaseLayout
  title="Joaquin Cardenas — FP&A & Business Intelligence"
  description="From audit to FP&A. Financial statements and public data turned into decisions that survive an audit."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">FP&amp;A &middot; Business Intelligence</p>
        <h1>From audit to FP&amp;A.</h1>
        <p class="lede">
          I turn financial statements and public data into decisions that survive an audit.
        </p>
        <div class="row">
          <a class="btn" href="/work/">See case studies &rarr;</a>
          <a class="btn btn-ghost" href="https://github.com/DaelFame">
            <Github class="brand-icon" /><span>GitHub</span>
          </a>
          <a class="btn btn-ghost" href="https://www.linkedin.com/in/joaquincardenas-data">
            <Linkedin class="brand-icon" /><span>LinkedIn</span>
          </a>
        </div>
      </div>

      <HeroWaterfall />
    </div>
  </section>

  <Pillars />
</BaseLayout>
