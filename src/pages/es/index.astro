---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CapabilityMap from '../../components/CapabilityMap.astro';
import SelectedWork from '../../components/SelectedWork.astro';
import Process from '../../components/Process.astro';
import Github from '../../components/Github.astro';
import Linkedin from '../../components/Linkedin.astro';
import { useTranslations } from '../../i18n/utils';
import { profile } from '../../data/profile';

const lang = 'es' as const;
const t = useTranslations(lang);
---

<BaseLayout title={t('meta.home.title')} description={t('meta.home.description')} lang={lang}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t('hero.eyebrow')}</p>
        <h1>{t('hero.title')}</h1>
        <p class="lede">{t('hero.lede')}</p>
        <div class="row">
          <a class="btn" href="/es/work/">{t('hero.cta')} &rarr;</a>
          <a class="btn btn-ghost" href="https://github.com/DaelFame">
            <Github class="brand-icon" /><span>GitHub</span>
          </a>
          <a class="btn btn-ghost" href="https://www.linkedin.com/in/joaquincardenas-data">
            <Linkedin class="brand-icon" /><span>LinkedIn</span>
          </a>
        </div>

        <p class="hero-available">
          <span class="dot" aria-hidden="true"></span>
          <span>{t('hero.available')}.</span>
          <a href={`mailto:${profile.email}`}>{t('hero.email')} &rarr;</a>
        </p>
      </div>

      <CapabilityMap lang={lang} />
    </div>
  </section>

  <SelectedWork lang={lang} />
  <Process lang={lang} />
</BaseLayout>
