---
import type { Lang } from '../i18n/ui';

/**
 * Positioning first, evidence second.
 * Each pillar states a capability; the line underneath carries the proof.
 * Numbers are evidence — they live in the case studies, not in the pitch.
 */
const pillars = [
  {
    index: '01',
    title: { en: 'Accounting foundation', es: 'Base contable' },
    body: {
      en: 'IFRS, month-end close, AP/AR, P&L structure. I know what a number is supposed to mean before I try to move it.',
      es: 'IFRS, cierre de mes, AP/AR, estructura del P&L. Sé qué debería significar un número antes de intentar moverlo.',
    },
    proof: {
      en: 'Reconciled accounts for IFRS audit engagements at KPMG',
      es: 'Concilié cuentas para encargos de auditoría IFRS en KPMG',
    },
    href: '/work/',
  },
  {
    index: '02',
    title: { en: 'Technical execution', es: 'Ejecución técnica' },
    body: {
      en: 'Python, SQL, DuckDB, Power BI. Pipelines and models that run again tomorrow without someone babysitting them.',
      es: 'Python, SQL, DuckDB, Power BI. Pipelines y modelos que vuelven a correr mañana sin que nadie los vigile.',
    },
    proof: {
      en: '29.5M rows into a star schema that reconciles to S/ 0.00',
      es: '29.5M filas en un star schema que reconcilia a S/ 0.00',
    },
    href: '/work/',
  },
  {
    index: '03',
    title: { en: 'Audit-grade rigour', es: 'Rigor auditable' },
    body: {
      en: 'Every figure traceable to a file, sheet and cell. Every assumption written down. Every gap left visible instead of smoothed away.',
      es: 'Cada cifra trazable a un archivo, hoja y celda. Cada supuesto escrito. Cada hueco visible en lugar de maquillado.',
    },
    proof: {
      en: '€150,000 of unsupported expenses kept visible',
      es: '€150.000 de gastos sin respaldo, dejados a la vista',
    },
    href: '/work/',
  },
];

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="pillars" aria-label={lang === 'es' ? 'Qué aporto' : 'What I bring'}>
  <div class="container pillars-grid">
    {
      pillars.map((p) => (
        <article class="pillar">
          <span class="pillar-index">{p.index}</span>
          <h3>{p.title[lang]}</h3>
          <p>{p.body[lang]}</p>
          <a class="pillar-proof" href={p.href}>
            <span class="arrow" aria-hidden="true">
              &rarr;
            </span>
            <span>{p.proof[lang]}</span>
          </a>
        </article>
      ))
    }
  </div>
</section>
