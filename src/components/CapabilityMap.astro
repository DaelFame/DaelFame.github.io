---
import type { Lang } from '../i18n/ui';

/**
 * Capability map: four overlapping circles that answer the recruiter's real
 * question — "what do I get if I hire this person?" — not a feelings diagram.
 * Each quadrant is a seat he can fill; the intersection is the rare part.
 *
 * The circles are interactive: hovering, focusing or tapping one lifts it and
 * explains it in a single caption line, which replaces the four-item legend
 * that used to sit underneath. Without JavaScript the legend is still there.
 * Colours come from CSS tokens, so both themes work with no per-theme code.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const data = {
  en: {
    center: 'One workflow.',
    centerSub: '4 parts',
    phrase:
      'Record, understand, sustain, decide: four parts that in this profile come in the same person.',
    hint: 'Hover or tap a circle',
    aria: 'Four overlapping circles — accounting, finance, data engineering and BI — working as one workflow. Each one explains itself on hover or focus.',
    zones: [
      {
        id: 'accounting',
        label: 'Accounting',
        cx: 102, cy: 102, lx: 66, ly: 70,
        k: 'Accounting',
        v: 'Where the numbers live: every movement recorded, balanced and explainable.',
      },
      {
        id: 'fpa',
        label: 'Finance',
        cx: 218, cy: 102, lx: 254, ly: 70,
        k: 'Finance',
        v: 'Recording is not the end. The number is understood and used: budget, variance and the right use of resources.',
      },
      {
        id: 'data',
        label: 'Data Eng.',
        cx: 102, cy: 218, lx: 66, ly: 252,
        k: 'Data engineering',
        v: 'How the data travels, and how to shape it so it works as well as it can.',
      },
      {
        id: 'bi',
        label: 'BI',
        cx: 218, cy: 218, lx: 254, ly: 252,
        k: 'Business intelligence',
        v: 'The data comes back as a decision: what to do, with whom and on what evidence.',
      },
    ],
  },
  es: {
    center: 'Un flujo.',
    centerSub: '4 piezas',
    phrase:
      'Registrar, entender, sostener y decidir: cuatro piezas que en este perfil vienen en la misma persona.',
    hint: 'Pasa el cursor o toca un círculo',
    aria: 'Cuatro círculos superpuestos — contabilidad, finanzas, ingeniería de datos y BI — trabajando como un mismo flujo. Cada uno se explica al pasar el cursor o al enfocarlo.',
    zones: [
      {
        id: 'accounting',
        label: 'Contabilidad',
        cx: 102, cy: 102, lx: 66, ly: 70,
        k: 'Contabilidad',
        v: 'El registro de los números: cada movimiento asentado, cuadrado y explicable.',
      },
      {
        id: 'fpa',
        label: 'Finanzas',
        cx: 218, cy: 102, lx: 254, ly: 70,
        k: 'Finanzas',
        v: 'Registrar es el principio, no el final: el número se entiende y se usa para el buen uso de los recursos.',
      },
      {
        id: 'data',
        label: 'Ing. de datos',
        cx: 102, cy: 218, lx: 66, ly: 252,
        k: 'Ingeniería de datos',
        v: 'Entiendo cómo viaja el dato y lo estructuro para que funcione lo mejor posible.',
      },
      {
        id: 'bi',
        label: 'BI',
        cx: 218, cy: 218, lx: 254, ly: 252,
        k: 'Business intelligence',
        v: 'El dato vuelve convertido en decisión: qué hacer, con quién y con qué evidencia.',
      },
    ],
  },
}[lang as 'en' | 'es'];
---

<div class="capmap" data-capmap>
  <script is:inline>document.documentElement.classList.add('js');</script>

  <svg viewBox="0 0 320 320" class="capmap-svg" role="group" aria-label={data.aria}>
    {
      data.zones.map((zone) => (
        <g
          class="capmap-zone"
          data-zone={zone.id}
          data-k={zone.k}
          data-v={zone.v}
          tabindex="0"
          role="button"
          aria-label={zone.label === zone.k ? `${zone.k}: ${zone.v}` : `${zone.label} — ${zone.k}: ${zone.v}`}
        >
          <circle cx={zone.cx} cy={zone.cy} r="76" class="capmap-ring" />
          <text x={zone.lx} y={zone.ly} text-anchor="middle" class="capmap-label">
            {zone.label}
          </text>
        </g>
      ))
    }

    <circle class="capmap-flow" r="3.2" aria-hidden="true">
      <animateMotion
        dur="18s"
        repeatCount="indefinite"
        path="M102,102 C150,78 190,78 218,102 C242,126 242,194 218,218 C170,242 130,242 102,218 C78,194 78,130 102,102 Z"
      ></animateMotion>
    </circle>
    <circle class="capmap-flow capmap-flow--dim" r="2.2" aria-hidden="true">
      <animateMotion
        dur="18s"
        begin="-9s"
        repeatCount="indefinite"
        path="M102,102 C150,78 190,78 218,102 C242,126 242,194 218,218 C170,242 130,242 102,218 C78,194 78,130 102,102 Z"
      ></animateMotion>
    </circle>

    <circle cx="160" cy="160" r="50" class="capmap-core" />
    <text x="160" y="157" text-anchor="middle" class="capmap-core-title">{data.center}</text>
    <text x="160" y="173" text-anchor="middle" class="capmap-core-sub">{data.centerSub}</text>
  </svg>

  <p class="capmap-hint">{data.hint}</p>

  <p class="capmap-caption" data-capmap-caption aria-live="polite">
    <span class="capmap-caption-k" data-capmap-k></span>
    <span class="capmap-caption-v" data-capmap-v>{data.phrase}</span>
  </p>

  <ul class="capmap-fallback">
    {
      data.zones.map((zone) => (
        <li>
          <span class="capmap-k">{zone.k}</span>
          <span class="capmap-v">{zone.v}</span>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const maps = document.querySelectorAll<HTMLElement>('[data-capmap]');

  maps.forEach((root) => {
    const zones = Array.from(root.querySelectorAll<SVGGElement>('.capmap-zone'));
    const caption = root.querySelector<HTMLElement>('[data-capmap-caption]');
    const kEl = root.querySelector<HTMLElement>('[data-capmap-k]');
    const vEl = root.querySelector<HTMLElement>('[data-capmap-v]');
    const base = vEl?.textContent ?? '';
    let pinned: SVGGElement | null = null;

    const render = (zone: SVGGElement | null) => {
      root.dataset.active = zone?.dataset.zone ?? '';
      zones.forEach((z) => z.classList.toggle('is-active', z === zone));
      if (!kEl || !vEl || !caption) return;
      caption.classList.remove('is-changing');
      void caption.offsetWidth;
      caption.classList.add('is-changing');
      kEl.textContent = zone?.dataset.k ?? '';
      vEl.textContent = zone?.dataset.v ?? base;
    };

    const settle = () => {
      const focused = zones.find((z) => z === document.activeElement);
      render(pinned ?? focused ?? null);
    };

    zones.forEach((zone) => {
      zone.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') render(zone);
      });
      zone.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'mouse') settle();
      });
      zone.addEventListener('focus', () => render(zone));
      zone.addEventListener('blur', () => settle());
      zone.addEventListener('click', () => {
        pinned = pinned === zone ? null : zone;
        render(pinned ?? zone);
      });
      zone.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          pinned = pinned === zone ? null : zone;
          render(pinned ?? zone);
        }
        if (event.key === 'Escape') {
          pinned = null;
          zone.blur();
          render(null);
        }
      });
    });

    document.addEventListener('click', (event) => {
      if (pinned && !root.contains(event.target as Node)) {
        pinned = null;
        render(null);
      }
    });

    render(null);
  });
</script>
