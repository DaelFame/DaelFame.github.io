---
import type { Lang } from '../i18n/ui';

/**
 * Capability map: four overlapping circles that answer the recruiter's real
 * question — "what do I get if I hire this person?" — not a feelings diagram.
 * Each quadrant is a seat he can fill; the intersection is the rare part.
 * Colours come from CSS tokens, so both themes work with no per-theme code.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const data = {
  en: {
    accounting: 'Accounting',
    fpa: 'FP&A',
    data: 'Data Eng.',
    bi: 'BI',
    center1: 'One workflow.',
    center2: '',
    phrase: 'Accounting, finance, data and BI in one workflow.',
    aria: 'Four overlapping circles — accounting, FP&A, data engineering and BI — working as one workflow.',
    legend: [
      { k: 'Accounting', v: 'The books close: AP/AR, month-end and reconciliations that actually tie out.' },
      { k: 'FP&A', v: 'The numbers are explained: budget vs actual, variance and scenarios.' },
      { k: 'Data engineering', v: 'The data holds: pipelines, a star schema, 131 tests, reconciliation gates.' },
      { k: 'Business intelligence', v: 'The decision is made: dashboards that end in a recommendation.' },
    ],
  },
  es: {
    accounting: 'Contabilidad',
    fpa: 'FP&A',
    data: 'Ing. de datos',
    bi: 'BI',
    center1: 'Un flujo.',
    center2: '',
    phrase: 'Contabilidad, finanzas, datos y BI en un mismo flujo.',
    aria: 'Cuatro círculos superpuestos — contabilidad, FP&A, ingeniería de datos y BI — trabajando como un mismo flujo.',
    legend: [
      { k: 'Contabilidad', v: 'El cierre cuadra: AP/AR, cierre de mes y conciliaciones que cierran de verdad.' },
      { k: 'FP&A', v: 'Los números se explican: presupuesto vs real, varianza y escenarios.' },
      { k: 'Ingeniería de datos', v: 'Los datos se sostienen: pipelines, star schema, 131 tests, gates de conciliación.' },
      { k: 'Business intelligence', v: 'La decisión se toma: dashboards que terminan en una recomendación.' },
    ],
  },
}[lang as 'en' | 'es'];
---

<div class="ikigai">
  <svg viewBox="0 0 320 320" role="img" aria-label={data.aria}>
    <circle cx="102" cy="102" r="76" fill="var(--accent-soft)" fill-opacity="0.45" stroke="var(--accent)" stroke-opacity="0.4" />
    <circle cx="218" cy="102" r="76" fill="var(--accent-soft)" fill-opacity="0.45" stroke="var(--accent)" stroke-opacity="0.4" />
    <circle cx="102" cy="218" r="76" fill="var(--accent-soft)" fill-opacity="0.45" stroke="var(--accent)" stroke-opacity="0.4" />
    <circle cx="218" cy="218" r="76" fill="var(--accent-soft)" fill-opacity="0.45" stroke="var(--accent)" stroke-opacity="0.4" />

    <circle cx="160" cy="160" r="50" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5" />

    <text x="66" y="70" text-anchor="middle" class="ikigai-label">{data.accounting}</text>
    <text x="254" y="70" text-anchor="middle" class="ikigai-label">{data.fpa}</text>
    <text x="66" y="252" text-anchor="middle" class="ikigai-label">{data.data}</text>
    <text x="254" y="252" text-anchor="middle" class="ikigai-label">{data.bi}</text>

    <text x="160" y="153" text-anchor="middle" class="ikigai-center">{data.center1}</text>
    <text x="160" y="172" text-anchor="middle" class="ikigai-center">{data.center2}</text>
  </svg>

  <p class="ikigai-phrase">{data.phrase}</p>

  <ul class="ikigai-legend">
    {data.legend.map((item) => (
      <li>
        <span class="ikigai-k">{item.k}</span>
        <span class="ikigai-v">{item.v}</span>
      </li>
    ))}
  </ul>
</div>
