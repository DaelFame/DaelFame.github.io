---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

/**
 * Variance waterfall for the FP&A case.
 * Geometry derives from one array — change a value and the bars follow.
 * Animation is CSS-only: zero JavaScript.
 */
interface Props {
  lang: Lang;
  /** Show the "from the FP&A case study" attribution (hidden on the case page itself). */
  showCaption?: boolean;
}

const { lang, showCaption = true } = Astro.props;
const t = useTranslations(lang);
const caseHref = lang === 'es' ? '/es/work/' : '/work/';

const bridge = [
  { en: 'Gross margin', es: 'Margen bruto', value: 74_457 },
  { en: 'Operating expenses', es: 'Gastos operativos', value: -359_888 },
  { en: 'Financial result', es: 'Resultado financiero', value: 24_294 },
  { en: 'Extraordinary result', es: 'Resultado extraordinario', value: 18_000 },
];

const copy = {
  en: {
    headline: 'Where the €243,137 went',
    period: 'Year 1 · EUR',
    net: 'Net variance',
    note: '€150,000 of general expenses carry no supporting document.',
    alt: 'Waterfall chart: revenue met plan, but operating expenses of 359,888 euros left a net variance of minus 243,137 euros.',
  },
  es: {
    headline: 'Dónde se fueron los €243.137',
    period: 'Año 1 · EUR',
    net: 'Varianza neta',
    note: '€150.000 de gastos generales no tienen respaldo documental.',
    alt: 'Gráfico de cascada: el ingreso llegó a presupuesto, pero 359.888 euros de gastos operativos dejaron una varianza neta de menos 243.137 euros.',
  },
}[lang];

const DOMAIN_MIN = -300_000;
const DOMAIN_MAX = 100_000;
const SPAN = DOMAIN_MAX - DOMAIN_MIN;

let running = 0;
const rows = bridge.map((d, i) => {
  const from = running;
  const to = running + d.value;
  running = to;
  return {
    label: d[lang],
    value: d.value,
    left: ((Math.min(from, to) - DOMAIN_MIN) / SPAN) * 100,
    width: (Math.abs(d.value) / SPAN) * 100,
    delay: i * 110,
  };
});

const net = running;
const netLeft = ((Math.min(0, net) - DOMAIN_MIN) / SPAN) * 100;
const netWidth = (Math.abs(net) / SPAN) * 100;
const zero = ((0 - DOMAIN_MIN) / SPAN) * 100;

const nf = new Intl.NumberFormat(lang === 'es' ? 'es-ES' : 'en-US');
const signed = (n: number) => `${n < 0 ? '−' : '+'}${nf.format(Math.abs(n))}`;
const plain = (n: number) => `${n < 0 ? '−' : ''}${nf.format(Math.abs(n))}`;
---

<div class="wf-wrap">
  <figure class="wf" aria-label={copy.alt}>
  <div class="wf-head">
    <h2 class="wf-title">{copy.headline}</h2>
    <span class="wf-sub">{copy.period}</span>
  </div>

  <div class="wf-rows" style={`--zero:${zero}%`}>
    {
      rows.map((r) => (
        <div class="wf-row">
          <span class="wf-label">{r.label}</span>
          <span class="wf-track">
            <span
              class:list={['wf-bar', r.value < 0 ? 'neg' : 'pos']}
              style={`left:${r.left}%;width:${r.width}%;--delay:${r.delay}ms`}
            />
          </span>
          <span class="wf-value">{signed(r.value)}</span>
        </div>
      ))
    }

    <div class="wf-divider"></div>

    <div class="wf-row wf-net">
      <span class="wf-label">{copy.net}</span>
      <span class="wf-track">
        <span class="wf-bar" style={`left:${netLeft}%;width:${netWidth}%;--delay:460ms`}></span>
      </span>
      <span class="wf-value">{plain(net)}</span>
    </div>
  </div>

  <figcaption class="wf-note">{copy.note}</figcaption>
  </figure>

  {
    showCaption && (
      <p class="wf-caption">
        <a href={caseHref}>{t('waterfall.fromCase')} <span aria-hidden="true">&rarr;</span></a>
      </p>
    )
  }
</div>
