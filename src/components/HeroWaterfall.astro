---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

/**
 * Variance waterfall for the FP&A case.
 * Geometry derives from one array — change a value and the bars follow.
 * Animation is CSS-only: zero JavaScript.
 */
interface Props {
  lang: Lang;
  /** Show the "from the FP&A case study" attribution (hidden on the case page itself). */
  showCaption?: boolean;
}

const { lang, showCaption = true } = Astro.props;
const t = useTranslations(lang);
const caseHref = lang === 'es' ? '/es/work/' : '/work/';

// Net income vs plan by year, pre-tax (fpa-forecasting-case-study README, live DAX).
// The bars must sum to the four-year variance: −243,137 + 351,995 + 499,886 + 259,201 = 867,945.
const bridge = [
  { en: '2026', es: '2026', value: -243_137, pct: -61.1 },
  { en: '2027', es: '2027', value: 351_995, pct: 127.0 },
  { en: '2028', es: '2028', value: 499_886, pct: 43.3 },
  { en: '2029', es: '2029', value: 259_201, pct: 12.2 },
];

const copy = {
  en: {
    headline: 'From a €243K miss to €868K ahead of plan',
    period: 'Net income vs plan · EUR · pre-tax',
    net: 'Four years',
    note: '+€572,000 of the surplus is extraordinary income — it will not repeat.',
    alt: 'Waterfall chart of net income versus plan by year: minus 243,137 euros in 2026, then plus 351,995, plus 499,886 and plus 259,201 euros, for a four-year total of plus 867,945 euros.',
  },
  es: {
    headline: 'De un hueco de €243K a €868K sobre el plan',
    period: 'Utilidad neta vs plan · EUR · antes de impuestos',
    net: 'Cuatro años',
    note: '+€572.000 del superávit es resultado extraordinario — no se repite.',
    alt: 'Gráfico de cascada de la utilidad neta frente al plan por año: menos 243.137 euros en 2026, luego más 351.995, más 499.886 y más 259.201 euros, para un total de más 867.945 euros en cuatro años.',
  },
}[lang];

const DOMAIN_MIN = -300_000;
const DOMAIN_MAX = 900_000;
const SPAN = DOMAIN_MAX - DOMAIN_MIN;

let running = 0;
const rows = bridge.map((d, i) => {
  const from = running;
  const to = running + d.value;
  running = to;
  return {
    label: d[lang],
    value: d.value,
    pct: d.pct,
    left: ((Math.min(from, to) - DOMAIN_MIN) / SPAN) * 100,
    width: (Math.abs(d.value) / SPAN) * 100,
    delay: i * 110,
  };
});

const net = running;
const netLeft = ((Math.min(0, net) - DOMAIN_MIN) / SPAN) * 100;
const netWidth = (Math.abs(net) / SPAN) * 100;
const zero = ((0 - DOMAIN_MIN) / SPAN) * 100;

const nf = new Intl.NumberFormat(lang === 'es' ? 'es-ES' : 'en-US');
const signed = (n: number) => `${n < 0 ? '−' : '+'}${nf.format(Math.abs(n))}`;
const pf = new Intl.NumberFormat(lang === 'es' ? 'es-ES' : 'en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const pct = (n: number) => `${n < 0 ? '−' : '+'}${pf.format(Math.abs(n))}%`;
---

<div class="wf-wrap">
  <figure class="wf" aria-label={copy.alt}>
  <div class="wf-head">
    <h2 class="wf-title">{copy.headline}</h2>
    <span class="wf-sub">{copy.period}</span>
  </div>

  <div class="wf-rows" style={`--zero:${zero}%`}>
    {
      rows.map((r) => (
        <div class="wf-row">
          <span class="wf-label">{r.label} <span class="wf-pct">{pct(r.pct)}</span></span>
          <span class="wf-track">
            <span
              class:list={['wf-bar', r.value < 0 ? 'neg' : 'pos']}
              style={`left:${r.left}%;width:${r.width}%;--delay:${r.delay}ms`}
            />
          </span>
          <span class="wf-value">{signed(r.value)}</span>
        </div>
      ))
    }

    <div class="wf-divider"></div>

    <div class="wf-row wf-net">
      <span class="wf-label">{copy.net}</span>
      <span class="wf-track">
        <span class="wf-bar pos" style={`left:${netLeft}%;width:${netWidth}%;--delay:460ms`}></span>
      </span>
      <span class="wf-value">{signed(net)}</span>
    </div>
  </div>

  <figcaption class="wf-note">{copy.note}</figcaption>
  </figure>

  {
    showCaption && (
      <p class="wf-caption">
        <a href={caseHref}>{t('waterfall.fromCase')} <span aria-hidden="true">&rarr;</span></a>
      </p>
    )
  }
</div>
