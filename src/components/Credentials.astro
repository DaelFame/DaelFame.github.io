---
import type { Lang } from '../i18n/ui';

/**
 * One-line credential strip under the hero: the proof a recruiter scans for
 * in the first seconds. Credentials, not a metric grid (S5).
 * Source of truth: src/data/profile.ts (experience, languages).
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const data = {
  en: {
    label: 'Credentials',
    items: [
      { k: 'KPMG Peru', v: 'Audit Data Analyst Intern' },
      { k: '1st globally', v: 'KPMG Audit Foundations 1' },
      { k: '2 → 6 locations', v: 'Restaurant I ran on its own numbers' },
      { k: 'English B2', v: 'Two seasons working in the US' },
    ],
  },
  es: {
    label: 'Credenciales',
    items: [
      { k: 'KPMG Perú', v: 'Pasante de Auditoría de Datos' },
      { k: '1.er puesto global', v: 'KPMG Audit Foundations 1' },
      { k: '2 → 6 locales', v: 'Restaurante que administré con sus números' },
      { k: 'Inglés B2', v: 'Dos temporadas trabajando en EE. UU.' },
    ],
  },
}[lang];
---

<section class="creds" aria-label={data.label}>
  <div class="container">
  <ul class="creds-list">
    {
      data.items.map((item) => (
        <li class="creds-item">
          <strong>{item.k}</strong>
          <span>{item.v}</span>
        </li>
      ))
    }
  </ul>
  </div>
</section>

<style>
  .creds {
    border-block: 1px solid var(--line);
    background: var(--paper-2);
  }

  .creds-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .creds-item {
    display: grid;
    gap: 0.15rem;
    padding: 1.1rem 1rem 1.1rem 0;
  }

  .creds-item strong {
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .creds-item span {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .creds-item + .creds-item {
      padding-inline-start: 1.25rem;
      border-inline-start: 1px solid var(--line);
    }
  }
</style>
