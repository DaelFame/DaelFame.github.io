---
import { metrics } from '../data/metrics';

const lang: 'en' | 'es' = 'en';
---

<section class="proof" aria-label="Key figures">
  <div class="container proof-grid">
    {
      metrics.map((m) => (
        <div class="proof-item">
          <span class="num">{m.value}</span>
          <p>{m.label[lang]}</p>
        </div>
      ))
    }
  </div>
</section>
