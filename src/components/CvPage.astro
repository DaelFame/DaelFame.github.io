---
import type { Lang } from '../i18n/ui';
import { profile, p } from '../data/profile';
import { cases } from '../data/cases';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = p(lang);
const cvFile = lang === 'es' ? '/cv/joaquin-cardenas-cv-es.pdf' : '/cv/joaquin-cardenas-cv-en.pdf';
const downloadLabel = lang === 'es' ? 'Descargar PDF' : 'Download PDF';

const labels = {
  en: { summary: 'Summary', projects: 'Projects', experience: 'Experience', education: 'Education & certifications', skills: 'Skills', languages: 'Languages' },
  es: { summary: 'Resumen', projects: 'Proyectos', experience: 'Experiencia', education: 'Formación y certificaciones', skills: 'Habilidades', languages: 'Idiomas' },
}[lang];
---

<div class="cv">
  <div class="cv-toolbar">
    <a class="btn btn-sm" href={cvFile} download>{downloadLabel} &darr;</a>
  </div>

  <header class="cv-head">
    <h1>{profile.name}</h1>
    <p class="cv-line">{t(profile.location)} · {profile.email}</p>
    <p class="cv-line">linkedin.com/in/joaquincardenas-data · github.com/DaelFame</p>
    <p class="cv-summary">{t(profile.summary)}</p>
  </header>

  <section class="cv-block">
    <h2>{labels.projects}</h2>
    {
      cases.map((c) => (
        <div class="cv-job">
          <div class="cv-job-head">
            <strong>{c.title}</strong>
            <span class="cv-period">{t(c.period)}</span>
          </div>
          <p class="cv-org">{c.discipline[lang]}</p>
          <ul>
            {c.cvBullets.map((b) => <li>{t(b)}</li>)}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="cv-block">
    <h2>{labels.experience}</h2>
    {
      profile.experience.map((job) => (
        <div class="cv-job">
          <div class="cv-job-head">
            <strong>{t(job.role)}</strong>
            <span class="cv-period">{t(job.period)}</span>
          </div>
          <p class="cv-org">
            {t(job.org)}
            {job.location ? ` — ${t(job.location)}` : ''}
          </p>
          <ul>
            {job.bullets.map((b) => <li>{t(b)}</li>)}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="cv-block">
    <h2>{labels.education}</h2>
    <ul>
      {
        profile.education.map((ed) => (
          <li><strong>{t(ed.degree)}</strong> — {t(ed.org)}, {t(ed.period)}</li>
        ))
      }
      {profile.certifications.map((c) => <li>{t(c)}</li>)}
    </ul>
  </section>

  <section class="cv-block">
    <h2>{labels.skills}</h2>
    {
      profile.skills.map((s) => (
        <p class="cv-org"><strong>{t(s.group)}:</strong> {t(s.items)}</p>
      ))
    }
    <p class="cv-org"><strong>{labels.languages}:</strong> {t(profile.languages)}</p>
  </section>
</div>
