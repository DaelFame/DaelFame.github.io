---
import type { Lang } from '../i18n/ui';
import { profile, p } from '../data/profile';
import Github from './Github.astro';
import Linkedin from './Linkedin.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = p(lang);
const labels = {
  en: { languages: 'Languages', looking: 'What I am looking for', cv: 'Full CV', cvHref: '/cv/' },
  es: { languages: 'Idiomas', looking: 'Qué busco', cv: 'CV completo', cvHref: '/es/cv/' },
}[lang];
---

<div class="about about--narrative">
  <header class="about-head">
    <p class="eyebrow">{t(profile.title)}</p>
    <h1 class="page-title">{profile.name}</h1>
    <p class="lede about-narrative">{t(profile.about)}</p>

    <div class="row about-cta">
      <a class="btn" href={`mailto:${profile.email}`}>{profile.email}</a>
      <a class="btn btn-ghost" href="https://www.linkedin.com/in/joaquincardenas-data">
        <Linkedin class="brand-icon" /><span>LinkedIn</span>
      </a>
      <a class="btn btn-ghost" href="https://github.com/DaelFame">
        <Github class="brand-icon" /><span>GitHub</span>
      </a>
      <a class="btn btn-ghost" href={labels.cvHref}>{labels.cv} &rarr;</a>
    </div>
  </header>

  <section class="about-block about-cols">
    <div>
      <h2>{labels.looking}</h2>
      <ul class="plain-list">
        <li>{lang === 'es' ? 'Roles remotos de datos financieros, BI o FP&A.' : 'Remote financial data, BI or FP&A roles.'}</li>
        <li>{lang === 'es' ? 'Equipos donde contabilidad y datos se hablan en el mismo idioma.' : 'Teams where accounting and data speak the same language.'}</li>
      </ul>
    </div>

    <div>
      <h2>{labels.languages}</h2>
      <ul class="plain-list">
        <li>{t(profile.languages)}</li>
        <li>{lang === 'es' ? 'Español: nativo' : 'Spanish: native'}</li>
      </ul>
    </div>
  </section>
</div>
