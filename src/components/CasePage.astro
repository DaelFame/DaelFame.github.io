---
import type { Lang } from '../i18n/ui';
import { cases, type CaseStudy } from '../data/cases';
import { Image } from 'astro:assets';
import TechIcon from './TechIcon.astro';
import HeroWaterfall from './HeroWaterfall.astro';
import fpa01 from '../assets/cases/fpa/01-summary.png';
import fpa02 from '../assets/cases/fpa/02-profitability.png';
import fpa03 from '../assets/cases/fpa/03-variance.png';
import fpa04 from '../assets/cases/fpa/04-forecast.png';
import fpa05 from '../assets/cases/fpa/05-market.png';
import peruShot from '../assets/cases/peru.png';
import ucspShot from '../assets/cases/ucsp.png';

interface Props {
  item: CaseStudy;
  lang: Lang;
}

const { item, lang } = Astro.props;
const t = (f: { en: string; es: string }) => f[lang];

const idx = cases.findIndex((c) => c.slug === item.slug);
const next = idx >= 0 && idx < cases.length - 1 ? cases[idx + 1] : undefined;
const backHref = lang === 'es' ? '/es/work/' : '/work/';
const nextHref = next ? (lang === 'es' ? `/es${next.href}` : next.href) : undefined;
const readRepo = lang === 'es' ? 'Leer el repositorio' : 'Read the repository';
const nextLabel = lang === 'es' ? 'Siguiente caso' : 'Next case';
const backLabel = lang === 'es' ? 'Volver al trabajo' : 'Back to work';

type Shot = { src: typeof fpa01; caption: { en: string; es: string } };

const GALLERY: Record<string, Shot[]> = {
  'fpa-forecasting': [
    {
      src: fpa01,
      caption: {
        en: '01 | Summary — five-year P&L, gross-margin trend and the year matrix, with report page tooltips on every card (FY 2024–2029, pre-tax).',
        es: '01 | Summary — P&L de cinco años, tendencia del margen bruto y la matriz por año, con report page tooltips en cada tarjeta (FY 2024–2029, pre-tax).',
      },
    },
    {
      src: fpa02,
      caption: {
        en: '02 | Profitability — margin by product line, revenue mix and gross-margin contribution: ties carry 72.1% of revenue and 79% of margin.',
        es: '02 | Profitability — margen por línea de producto, mezcla de ingresos y contribución al margen bruto: las corbatas sostienen 72,1% del ingreso y 79% del margen.',
      },
    },
    {
      src: fpa03,
      caption: {
        en: '03 | Variance — plan versus actual: a driver bridge, the year matrix and the operating-expense overrun line by line (+€867,945, +21.9%).',
        es: '03 | Variance — plan versus real: puente de drivers, matriz por año y el sobrecosto operativo línea por línea (+€867.945, +21,9%).',
      },
    },
    {
      src: fpa04,
      caption: {
        en: '04 | Forecast — the 2030 scenario band, backtest accuracy per fold and forecast error by headline line (2029 fold: 76.2% accurate, −21.4% bias).',
        es: '04 | Forecast — banda de escenarios 2030, exactitud del backtest por fold y error por línea principal (fold 2029: 76,2% de exactitud, sesgo −21,4%).',
      },
    },
    {
      src: fpa05,
      caption: {
        en: '05 | Market — published demand, unserved units and market share: 594,748 units unserved in 2028, share up from 14.3% to 20.1%.',
        es: '05 | Market — demanda publicada, unidades sin atender y cuota de mercado: 594.748 unidades sin atender en 2028, cuota de 14,3% a 20,1%.',
      },
    },
  ],
  'peru-budget-lakehouse': [
    {
      src: peruShot,
      caption: {
        en: 'Executive dashboard — planned versus executed budget, distribution by economic category and the sample-mode disclosure on the same screen.',
        es: 'Dashboard ejecutivo — presupuesto planificado versus ejecutado, distribución por categoría económica y la advertencia de modo muestra en la misma pantalla.',
      },
    },
  ],
  'ucsp-market-intelligence': [
    {
      src: ucspShot,
      caption: {
        en: '01 | Situación actual — enrollment, market share and the ranking inside Arequipa, with the growth and leakage summary at the top.',
        es: '01 | Situación actual — matrícula, market share y el ranking dentro de Arequipa, con el resumen de crecimiento y fuga en la parte superior.',
      },
    },
  ],
};

const gallery = GALLERY[item.slug] ?? [];
const galleryLabel = lang === 'es' ? 'Capturas del dashboard' : 'Dashboard screenshots';

---

<article class="case">
  <header class="case-head">
    <p class="eyebrow">{t(item.discipline)} &middot; {t(item.period)}</p>
    <h1 class="case-h1">{item.title}</h1>
    <p class="case-question-lg">{t(item.question)}</p>
    {item.disclosure && <p class="case-disclosure case-disclosure--lg">{t(item.disclosure)}</p>}
    <p class="case-result-lg">{t(item.result)}</p>

    <div class="metric-grid">
      {
        item.metrics.map((m) => (
          <div class="metric">
            <span class="num">{t(m.value)}</span>
            <span>{t(m.label)}</span>
          </div>
        ))
      }
    </div>

    <ul class="case-stack case-stack--lg">
      {item.stack.map((tech) => (
        <li>
          <TechIcon slug={tech.slug} class="tech-mark" />
          <span>{tech.label}</span>
        </li>
      ))}
    </ul>

    {
      item.inProgress && (
        <p class="case-wip">{t(item.inProgress)}</p>
      )
    }
  </header>

  {
    gallery.length > 0 && (
      <section class="case-gallery">
        <h2 class="case-gallery-title">{galleryLabel}</h2>
        {gallery.map((shot) => (
          <figure class="case-shot">
            <Image
              src={shot.src}
              alt={t(shot.caption)}
              widths={[640, 960, 1400]}
              sizes="(min-width: 1024px) 960px, 100vw"
              loading="lazy"
              decoding="async"
            />
            <figcaption>{t(shot.caption)}</figcaption>
          </figure>
        ))}
      </section>
    )
  }

  <div class="case-story">
    {
      item.story.map((section, i) => (
        <section class="case-section">
          <h2 class="case-section-title">
            <span class="case-section-n">{String(i + 1).padStart(2, '0')}</span>
            {t(section.title)}
          </h2>

          {section.waterfall && <HeroWaterfall lang={lang} showCaption={false} />}

          {section.body.map((p) => <p class="case-para">{t(p)}</p>)}
        </section>
      ))
    }
  </div>

  <nav class="case-nav" aria-label={lang === 'es' ? 'Navegación del caso' : 'Case navigation'}>
    <a class="btn btn-ghost" href={backHref}>&larr; {backLabel}</a>
    <a class="btn" href={item.repo}>{readRepo} &rarr;</a>
    {nextHref && (
      <a class="btn btn-ghost" href={nextHref}>{nextLabel} &rarr;</a>
    )}
  </nav>
</article>