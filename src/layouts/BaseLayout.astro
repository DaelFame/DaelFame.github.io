---
// Self-hosted type: IBM Plex Sans, static 400 + 600 (headings). Each subset is a separate
// @font-face with unicode-range, so only Latin downloads. The 400 file is preloaded because
// the hero lede is the LCP element; the variable font (46 KB) pushed LCP past the 1.5 s budget.
// Labels and figures use the system monospace on purpose: a mono webfont cost ~0.3 s of FCP.
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import plexSansLatin from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import Github from '../components/Github.astro';
import Linkedin from '../components/Linkedin.astro';
import { useTranslations, localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  ogImage?: string;
  hideLangSwitch?: boolean;
}

const { title, description, lang = 'en', ogImage = '/og.png', hideLangSwitch = false } = Astro.props;
const t = useTranslations(lang);

const path = Astro.url.pathname;
const enUrl = new URL(localizePath(path, 'en'), Astro.site);
const esUrl = new URL(localizePath(path, 'es'), Astro.site);
const cvHref = lang === 'es' ? '/es/cv/' : '/cv/';
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href={plexSansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Joaquin Cardenas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_PE' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Joaquin Cardenas',
      jobTitle: 'Financial Data Analyst',
      description: 'Financial data analyst with an accounting background: FP&A, BI and analytics engineering.',
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad Católica San Pablo' },
      knowsAbout: ['FP&A', 'Variance analysis', 'Financial reporting', 'Power BI', 'DAX', 'SQL', 'Python', 'Data engineering'],
      knowsLanguage: ['es', 'en'],
      url: 'https://daelfame.github.io',
      email: 'mailto:Joaquin.data.dev@gmail.com',
      address: { '@type': 'PostalAddress', addressLocality: 'Arequipa', addressCountry: 'PE' },
      sameAs: [
        'https://github.com/DaelFame',
        'https://www.linkedin.com/in/joaquincardenas-data',
      ],
    })} />

    <!-- Set the theme before first paint so there is no flash of the wrong one. -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = stored || system;
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();

      // Remember the reader's language only on the root: a returning Spanish
      // reader lands on Spanish, an English one is not moved.
      (() => {
        try {
          if (location.pathname === '/' && localStorage.getItem('lang') === 'es') {
            location.replace('/es/');
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">{t('skip')}</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={lang === 'es' ? '/es/' : '/'}>Joaquin Cardenas</a>

        <nav class="nav" aria-label={t('nav.primary')}>
          <a href={localizePath('/work/', lang)}>{t('nav.work')}</a>
          <a href={localizePath('/about/', lang)}>{t('nav.about')}</a>
        </nav>

        <div class="header-actions">
          {!hideLangSwitch && <LangSwitcher lang={lang} path={path} />}
          <ThemeToggle />
          <a class="btn btn-ghost btn-sm" href={cvHref}>{t('nav.cv')}&nbsp;&darr;</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>&copy; {new Date().getFullYear()} Joaquin Cardenas &middot; {t('footer.rights')}</span>
        <span class="row footer-links">
          <a href="https://github.com/DaelFame"><Github class="brand-icon" /><span>GitHub</span></a>
          <a href="https://www.linkedin.com/in/joaquincardenas-data">
            <Linkedin class="brand-icon" /><span>LinkedIn</span>
          </a>
          <a href="mailto:Joaquin.data.dev@gmail.com">Email</a>
        </span>
      </div>
    </footer>
  </body>
</html>
